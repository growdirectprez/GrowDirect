<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="IXREnumerationExtensionV1.1.0.xsd"/>
	<xs:include schemaLocation="UnitOfMeasureCodeEnumerationV1.3.0.xsd"/>
	<xs:complexType name="RangeType">
		<xs:simpleContent>
			<xs:extension base="xs:decimal">
				<xs:attribute name="Closest" type="ClosestType"/>
				<xs:attribute name="UOM" type="UnitOfMeasureCodeCommonData"/>
				<xs:attribute name="MaxMin"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:simpleType name="ClosestType">
		<xs:union memberTypes="ClosestTypeEnumeration TypeCodeExtension"/>
	</xs:simpleType>
	<xs:simpleType name="ClosestTypeEnumeration">
		<xs:restriction base="xs:NMTOKEN">
			<xs:enumeration value="Directly"/>
			<xs:enumeration value="Driving"/>
			<xs:enumeration value="Walking"/>
			<xs:enumeration value="Bicycle"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MaxMinType">
		<xs:union memberTypes="MaxMinTypeEnumeration TypeCodeExtension"/>
	</xs:simpleType>
	<xs:simpleType name="MaxMinTypeEnumeration">
		<xs:restriction base="xs:NMTOKEN">
			<xs:enumeration value="Maximum"/>
			<xs:enumeration value="Minimum"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
