            </xs:annotation>
        </xs:attribute>
        <xs:attribute form="unqualified" name="TransmissionMedium" type="TransmissionMediumTypeCode">
            <xs:annotation>
                <xs:documentation>How information is available for transmission.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
