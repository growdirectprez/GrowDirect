                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" minOccurs="0" name="ContentCount" type="xs:integer">
                <xs:annotation>
                    <xs:documentation>A count of the number of items in this file</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" minOccurs="0" name="CreationDate" type="xs:date">
                <xs:annotation>
                    <xs:documentation>The date the file was created</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" minOccurs="0" name="DelayDate" type="xs:date">
