                    <xs:documentation>The date this file will be available</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" minOccurs="0" name="DeliveryDate" type="xs:date">
                <xs:annotation>
                    <xs:documentation>The date this file will be delivered</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" minOccurs="0" name="DigitalSignature"
                type="xs:base64Binary">
                <xs:annotation>
                    <xs:documentation>See RFC 3275 (optional) (future)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" minOccurs="0" name="FileFormat" type="xs:string">
                <xs:annotation>
                    <xs:documentation> Encoding method used to store asset.  The W3C site suggests,
                        http://www.w3.org/Daemon/User/Config/Suffixes.html,  the list of content
                        types can be extended.\</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" minOccurs="0" name="FileSize" type="xs:integer"/>
        </xs:sequence>
        <xs:attribute form="unqualified" name="Compression" type="FileCompressionTypeCode">
            <xs:annotation>
