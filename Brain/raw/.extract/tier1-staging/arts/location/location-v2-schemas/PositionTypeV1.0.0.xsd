<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="DescriptionCommonDataV1.3.0.xsd"/>
	<xs:include schemaLocation="URITypeV1.0.0.xsd"/>
	<xs:include schemaLocation="VertexCommonDataV1.0.0.xsd"/>
	<xs:complexType name="PositionType">
		<xs:complexContent>
			<xs:extension base="VertexCommonData">
				<xs:sequence>
					<xs:element name="Origin" minOccurs="0">
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="VertexCommonData"/>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element name="GlobalLocationNumber" type="xs:string" minOccurs="0"/>
					<xs:element name="URI" type="URIType" minOccurs="0"/>
					<xs:element name="Description" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Repeatable to allow for different languages</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:simpleContent>
								<xs:extension base="DescriptionCommonData"/>
							</xs:simpleContent>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
</xs:schema>
