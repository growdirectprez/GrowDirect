	<xs:include schemaLocation="PromotionTypeV1.0.0.xsd"/>
	<xs:include schemaLocation="RangeV1.0.0.xsd"/>
	<xs:include schemaLocation="URITypeV1.0.0.xsd"/>
	<xs:complexType name="DestinationLocationType">
		<xs:complexContent>
			<xs:extension base="PhysicalLocationType">
				<xs:sequence>
					<xs:element name="SequenceNumber" type="SequenceNumberType" minOccurs="0"/>
					<xs:element name="Name" type="xs:string" minOccurs="0"/>
					<xs:element name="Description" type="DescriptionCommonData" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element name="BusinessUnit" type="BusinessUnitCommonData" minOccurs="0"/>
					<xs:element name="Range" type="RangeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The range from the source location to the destination location</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="URI" type="URIType" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element name="DynamicData" type="DynamicDataCommonData" minOccurs="0" maxOccurs="unbounded"/>
					<xs:choice minOccurs="0" maxOccurs="unbounded">
						<xs:element name="ObjectOfInterest" type="ObjectOfInterestType"/>
						<xs:element name="MerchandiseHierarchy" type="MerchandiseHierarchyCommonData"/>
						<xs:element name="ItemID" type="ItemIDCommonData"/>
						<xs:element name="Promotion" type="PromotionType"/>
					</xs:choice>
					<xs:element name="RouteID" type="IDCommonData" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The id of the route to this object</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
</xs:schema>
