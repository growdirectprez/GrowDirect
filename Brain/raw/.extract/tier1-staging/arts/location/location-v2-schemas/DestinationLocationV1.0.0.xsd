<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="SequenceNumberCommonDataV1.0.0.xsd"/>
	<xs:include schemaLocation="BusinessUnitCommonDataV1.3.0.xsd"/>
	<xs:include schemaLocation="DescriptionCommonDataV1.3.0.xsd"/>
	<xs:include schemaLocation="DynamicDataCommonDataV1.0.0.xsd"/>
	<xs:include schemaLocation="ItemIDCommonDataV1.4.0.xsd"/>
	<xs:include schemaLocation="MerchandiseHierarchyCommonDataV1.1.0.xsd"/>
	<xs:include schemaLocation="ObjectOfInterestV1.0.0.xsd"/>
