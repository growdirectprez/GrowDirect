            </xs:element>
            <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0"
                name="StyleColorPaletteID">
                <xs:annotation>
                    <xs:documentation>allows a Style to use multiple Color Palettes, and for a Color
                        Palette to be applicable to many Styles</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="xs:string">
                            <xs:attribute form="unqualified" name="Name" type="xs:string"/>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>
            <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0"
                name="StyleDesignDetailID">
                <xs:annotation>
                    <xs:documentation>links a label style with a design detail. The multiple design
                        details associated with a style provide the "style
                        description".</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="xs:string">
                            <xs:attribute form="unqualified" name="Name" type="xs:string"/>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>
            <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0" name="CareAndUseCode"
                type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
