    <xs:complexType name="StyleCommonData">
        <xs:sequence>
            <xs:element form="qualified" name="StyleID">
                <xs:annotation>
                    <xs:documentation>A unique product within a Label, which may be manufactured in
                        many colors and/or sizes. The term "Style" is often used to mean "Label
                        Style", but a Style Code alone may not be unique when viewing merchandise
                        from multiple manufacturers</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:simpleContent>
