# {{ project_name }} — Roof Planes
# Generated by ARC AI Draftsman.
# Boundaries are pre-expanded by overhang in the Python generator.

H = {{ module_name }}
model = Sketchup.active_model
ents = model.active_entities

model.start_operation("{{ project_name }} Roof", true)

{% for plane in roof_planes %}
# Roof plane: {{ plane.label }} ({{ plane.type }}, slope={{ plane.slope }}, overhang={{ plane.overhang }}ft)
roof_grp = H.tagged_group(ents, model, "Roof")
roof_grp.name = "{{ plane.label | replace(' ', '_') }}"
roof_pts = [
{% for pt in plane.expanded_boundary %}
  H.pt({{ pt[0] }}, {{ pt[1] }}, {{ plane.z_base }}),
{% endfor %}
]
roof_face = roof_grp.entities.add_face(roof_pts)
if roof_face
  roof_face.reverse! if roof_face.normal.z < 0
  roof_face.pushpull(H.ft(0.4))  # 0.4ft roof thickness
end
{% endfor %}

model.commit_operation
puts "{{ project_name }} roof complete."
