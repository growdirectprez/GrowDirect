# {{ project_name }} — Structural Posts and Beams
# Generated by ARC AI Draftsman.

H = {{ module_name }}
model = Sketchup.active_model
ents = model.active_entities

model.start_operation("{{ project_name }} Structure", true)

# ============================================================
# Posts
# ============================================================
{% for post in posts %}
post_grp = H.tagged_group(ents, model, "Structure/Posts")
post_grp.name = "post_{{ loop.index }}"
H.make_post(post_grp, {{ post.x }}, {{ post.y }}, {{ post.size_in }}, {{ plate_height }}, {{ post.z_base }})
{% endfor %}

# ============================================================
# Beams
# ============================================================
{% for beam in beams %}
beam_grp = H.tagged_group(ents, model, "Structure/Beams")
{% if beam.label %}
beam_grp.name = "{{ beam.label }}"
{% else %}
beam_grp.name = "beam_{{ loop.index }}"
{% endif %}
H.make_beam(
  beam_grp,
  [{{ beam.from_x }}, {{ beam.from_y }}],
  [{{ beam.to_x }}, {{ beam.to_y }}],
  {{ beam.width_in }},
  {{ beam.depth_in }},
  {{ beam.z }}
)
{% endfor %}

model.commit_operation
puts "{{ project_name }} structure complete."
