# Angel Flask App Configuration
# Copy this to .env and fill in actual values
# .env is gitignored — never commit secrets

# Flask
FLASK_ENV=dev
SECRET_KEY=change-me-in-production

# Database (Angel uses separate DB; Cove uses 'cove')
DATABASE_URL=postgresql://growdirect:growdirect_dev@growdirect_postgres:5432/angel
TEST_DATABASE_URL=postgresql://growdirect:growdirect_dev@growdirect_postgres:5432/angel_test

# Session backend (Valkey/Redis)
VALKEY_URL=redis://growdirect_valkey:6379/3

# Webhook security — get from Luxury Presence dashboard
LP_WEBHOOK_SECRET=your-lp-webhook-secret-here

# Optional: if running locally (not in Docker)
# DATABASE_URL=postgresql://growdirect:growdirect_dev@localhost:5432/angel
# VALKEY_URL=redis://localhost:6379/3
