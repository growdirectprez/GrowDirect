# {{ project_name }} — Walls
# Generated by ARC AI Draftsman.
# {{ wall_count }} wall(s) across {{ floors | length }} floor(s).

H = {{ module_name }}
model = Sketchup.active_model
ents = model.active_entities

model.start_operation("{{ project_name }} Walls", true)

{% for floor in floors %}
# ============================================================
# Floor: {{ floor.label }} (z={{ floor.z_origin }}, plate={{ floor.plate_height }}ft)
# ============================================================
{% for wall in floor.walls %}

# Wall: {{ wall.id }} ({{ wall.wall_type }})
wall_grp = H.tagged_group(ents, model, "{{ wall.wall_type | capitalize == 'Exterior' and 'Walls/Exterior' or 'Walls/Interior' }}")
wall_grp.name = "{{ wall.id }}"
H.make_wall(
  wall_grp,
  [{{ wall.from_x }}, {{ wall.from_y }}],
  [{{ wall.to_x }}, {{ wall.to_y }}],
  {{ wall.thickness_ft }},
  {{ wall.plate_height }},
  {{ floor.z_origin }}
)
{% for opening in wall.openings %}

# Opening: {{ opening.type }} ({{ opening.width }}ft wide x {{ opening.height }}ft tall, sill {{ opening.sill_height }}ft)
cutter = ents.add_group
H.make_box(
  cutter,
  {{ opening.cut_x }},
  {{ opening.cut_y }},
  {{ floor.z_origin }} + {{ opening.sill_height }},
  {{ opening.cut_w }},
  {{ opening.cut_d }},
  {{ opening.height }}
)
wall_grp.subtract(cutter)
{% endfor %}
{% endfor %}
{% endfor %}

model.commit_operation
puts "{{ project_name }} walls complete."
