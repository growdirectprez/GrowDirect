# {{ project_name }} — Camera Scenes
# Generated by ARC AI Draftsman.
# NOTE: Scene rendering is deferred for v0. This template is valid Jinja2 but
# is not rendered by the generator yet.

H = {{ module_name }}
model = Sketchup.active_model

model.start_operation("{{ project_name }} Scenes", true)

{% for scene in scenes %}
# Scene: {{ scene.name }}
begin
  pages = model.pages
  page = pages.add("{{ scene.name }}")

  eye    = Geom::Point3d.new({{ scene.eye[0] }}, {{ scene.eye[1] }}, {{ scene.eye[2] }})
  target = Geom::Point3d.new({{ scene.target[0] }}, {{ scene.target[1] }}, {{ scene.target[2] }})
  up     = Geom::Vector3d.new({{ scene.up[0] }}, {{ scene.up[1] }}, {{ scene.up[2] }})

  cam = Sketchup::Camera.new(eye, target, up)
  {% if scene.perspective %}
  cam.perspective = true
  {% else %}
  cam.perspective = false
  cam.height = {{ scene.view_height }}
  {% endif %}

  model.active_view.camera = cam

  {% if scene.section_plane %}
  sp = Sketchup::SectionPlane.new(
    Geom::Point3d.new({{ scene.section_plane.point[0] }}, {{ scene.section_plane.point[1] }}, {{ scene.section_plane.point[2] }}),
    Geom::Vector3d.new({{ scene.section_plane.normal[0] }}, {{ scene.section_plane.normal[1] }}, {{ scene.section_plane.normal[2] }})
  )
  model.active_entities.add_section_plane(sp)
  {% endif %}

  {% if scene.hidden_tags %}
  # Hide specified tags for this scene
  {% for tag_name in scene.hidden_tags %}
  tag = model.layers["{{ tag_name }}"]
  tag.visible = false if tag
  {% endfor %}
  {% endif %}

  page.update
rescue => e
  puts "Scene '{{ scene.name }}' failed: #{e.message}"
end
{% endfor %}

model.commit_operation
puts "{{ project_name }} scenes complete."
